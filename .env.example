COGNIVIA_LLM_PROVIDER=offline
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Optional durable learner memory store.
# Requires a compatible SQLAlchemy PostgreSQL driver when enabled.
DATABASE_URL=

# Optional LangSmith tracing for local smoke testing and observability.
# Use this when your LangSmith workspace is hosted in the EU region.
# Keep the real API key only in your local .env file, never in Git.
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=skill-compass-local
LANGCHAIN_TRACING_V2=false
